@model NashaMuktiDB.ViewModels.CreateCounsellingViewModel
@{
    ViewData["Title"] = "Record Counselling Session";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Record Counselling Session</h1>
        <p class="page-subtitle">Document an individual, group, or relapse counselling intervention.</p>
    </div>
    <div>
        @if (Model.BeneficiaryId > 0)
        {
            <a asp-controller="Beneficiaries" asp-action="Details" asp-route-id="@Model.BeneficiaryId" class="btn-outline-nm">
                <i class="bi bi-arrow-left"></i> Back to Beneficiary
            </a>
        }
        else
        {
            <a asp-action="Index" class="btn-outline-nm">
                <i class="bi bi-arrow-left"></i> Back to Sessions
            </a>
        }
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-journal-plus panel-icon"></i> Session Documentation Form
                </h2>
            </div>
            <div class="panel-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Beneficiary Selection / Preselection -->
                    @if (Model.BeneficiaryId > 0 && !string.IsNullOrEmpty(Model.BeneficiaryName))
                    {
                        <input type="hidden" asp-for="BeneficiaryId" />
                        <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="small-text text-muted text-uppercase fw-600 d-block">Recording session for</span>
                                <strong class="fs-6 text-navy">@Model.BeneficiaryName</strong>
                                <span class="id-chip ms-2">@Model.BeneficiaryCode</span>
                                @if (!string.IsNullOrEmpty(Model.CentreName))
                                {
                                    <div class="small-text text-muted"><i class="bi bi-hospital me-1"></i>@Model.CentreName</div>
                                }
                            </div>
                            <span class="badge bg-light text-success border border-success px-2 py-1">Pre-selected</span>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="BeneficiaryId" class="form-label fw-600">Beneficiary <span class="text-danger">*</span></label>
                            <select asp-for="BeneficiaryId" asp-items="Model.BeneficiariesList" class="form-select">
                                <option value="">-- Select Active Beneficiary --</option>
                            </select>
                            <span asp-validation-for="BeneficiaryId" class="text-danger small-text"></span>
                            <div class="form-text">Showing active beneficiaries in your authorized centre(s).</div>
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SessionDate" class="form-label fw-600">Session Date <span class="text-danger">*</span></label>
                            <input asp-for="SessionDate" type="date" class="form-control" />
                            <span asp-validation-for="SessionDate" class="text-danger small-text"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SessionType" class="form-label fw-600">Session Type <span class="text-danger">*</span></label>
                            <select asp-for="SessionType" asp-items="Model.TypesList" class="form-select"></select>
                            <span asp-validation-for="SessionType" class="text-danger small-text"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CounsellorName" class="form-label fw-600">Counsellor / Therapist</label>
                            <input asp-for="CounsellorName" class="form-control" placeholder="e.g. Dr. Harpreet Kaur / Counsellor Rajesh" />
                            <span asp-validation-for="CounsellorName" class="text-danger small-text"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SessionStatus" class="form-label fw-600">Session Status <span class="text-danger">*</span></label>
                            <select asp-for="SessionStatus" asp-items="Model.StatusesList" class="form-select"></select>
                            <span asp-validation-for="SessionStatus" class="text-danger small-text"></span>
                        </div>
                    </div>

                    <!-- Confidential Clinical Notes -->
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-600">
                            Clinical Notes &amp; Observations
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-2">Confidential</span>
                        </label>
                        <textarea asp-for="Notes" class="form-control" rows="5" 
                                  placeholder="Document mental health assessment, relapse triggers, coping strategies, or patient engagement notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small-text"></span>
                        <div class="alert alert-warning py-2 px-3 mt-2 small-text mb-0">
                            <i class="bi bi-shield-lock-fill text-warning me-1"></i>
                            <strong>Privacy Notice:</strong> Notes entered here contain sensitive medical information and are never displayed on public portals, dashboard summaries, or exported without authorization.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn-outline-nm">Cancel</a>
                        <button type="submit" class="btn-primary-nm">
                            <i class="bi bi-check2-circle"></i> Save Session Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

