@model NashaMuktiDB.ViewModels.EditBeneficiaryViewModel
@{
    ViewData["Title"] = $"Edit {Model.BeneficiaryCode}";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-pencil-square text-teal me-2"></i>Edit Beneficiary Record
        </h1>
        <p class="page-subtitle">
            Update personal intake information and operational status for record <strong>@Model.BeneficiaryCode</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.BeneficiaryId" class="btn-outline-nm">
            <i class="bi bi-eye"></i> View Profile
        </a>
        <a asp-action="Index" class="btn-outline-nm">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-person-gear panel-icon"></i> Editing Profile: @Model.FullName
                </h2>
                <span class="id-chip">@Model.BeneficiaryCode</span>
            </div>

            <div class="panel-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-nm alert-danger-nm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Edit" asp-route-id="@Model.BeneficiaryId" method="post" data-loading="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BeneficiaryId" />
                    <input type="hidden" asp-for="BeneficiaryCode" />

                    <div class="row g-3">
                        <!-- Beneficiary Code (Protected / Readonly) -->
                        <div class="col-md-6">
                            <label class="form-label-nm">Unique Beneficiary Identifier</label>
                            <input type="text" class="form-control-nm bg-light" value="@Model.BeneficiaryCode" readonly />
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-lock-fill me-1"></i>Permanent application identifier (cannot be changed).
                            </small>
                        </div>

                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label-nm">
                                Beneficiary Full Name <span class="required">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control-nm" required />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        <!-- Centre -->
                        <div class="col-md-6">
                            <label asp-for="CentreId" class="form-label-nm">
                                Assigned Facility <span class="required">*</span>
                            </label>
                            @if (Model.IsAdmin)
                            {
                                <select asp-for="CentreId" asp-items="Model.CentresList" class="form-control-nm" required></select>
                                <span asp-validation-for="CentreId" class="field-validation-error"></span>
                            }
                            else
                            {
                                <input type="hidden" asp-for="CentreId" />
                                <input type="text" class="form-control-nm bg-light" 
                                       value="@(Model.CentresList.FirstOrDefault(c => c.Value == Model.CentreId.ToString())?.Text ?? "Assigned Facility")" readonly />
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-lock-fill me-1"></i>Centre Staff cannot transfer beneficiaries across facilities.
                                </small>
                            }
                        </div>

                        <!-- Registration Date -->
                        <div class="col-md-6">
                            <label asp-for="RegistrationDate" class="form-label-nm">
                                Registration Date <span class="required">*</span>
                            </label>
                            <input asp-for="RegistrationDate" type="date" class="form-control-nm" 
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="RegistrationDate" class="field-validation-error"></span>
                        </div>

                        <!-- Date of Birth -->
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label-nm">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control-nm" 
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label-nm">Gender</label>
                            <select asp-for="Gender" class="form-control-nm">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                            <span asp-validation-for="Gender" class="field-validation-error"></span>
                        </div>

                        <!-- Contact Number -->
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label-nm">Contact Number</label>
                            <input asp-for="ContactNumber" type="tel" class="form-control-nm" />
                            <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label-nm">
                                Current Status <span class="required">*</span>
                            </label>
                            <select asp-for="Status" class="form-control-nm" required>
                                <option value="Active">Active (In Treatment)</option>
                                <option value="Inactive">Inactive / Suspended</option>
                                <option value="Discharged">Discharged (Treatment Complete)</option>
                            </select>
                            <span asp-validation-for="Status" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.BeneficiaryId" class="btn-outline-nm">Cancel</a>
                        <button type="submit" class="btn-primary-nm">
                            <i class="bi bi-check-circle-fill"></i> Save Updates
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
