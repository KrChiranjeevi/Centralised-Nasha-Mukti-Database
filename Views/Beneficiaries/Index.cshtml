@model NashaMuktiDB.ViewModels.BeneficiaryIndexViewModel
@{
    ViewData["Title"] = "Beneficiaries";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-people text-teal me-2"></i>Beneficiary Records
        </h1>
        <p class="page-subtitle">
            @if (Model.IsAdmin)
            {
                <span>National register of individuals enrolled across all supported Nasha Mukti Kendras</span>
            }
            else
            {
                <span>Registered beneficiaries under facility: <strong>@Model.UserCentreName</strong></span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a asp-action="Create" class="btn-primary-nm">
            <i class="bi bi-person-plus-fill"></i> Register New Beneficiary
        </a>
    </div>
</div>

<!-- Quick Metrics Bar -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="p-3 bg-white rounded border shadow-sm">
            <span class="small-text text-muted text-uppercase fw-600">Total Enrolled</span>
            <div class="fs-4 fw-bold text-navy">@Model.TotalBeneficiariesCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="p-3 bg-white rounded border shadow-sm">
            <span class="small-text text-muted text-uppercase fw-600">Active Beneficiaries</span>
            <div class="fs-4 fw-bold text-success">@Model.ActiveBeneficiariesCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="p-3 bg-white rounded border shadow-sm">
            <span class="small-text text-muted text-uppercase fw-600">Inactive / Discharged</span>
            <div class="fs-4 fw-bold text-secondary">@(Model.TotalBeneficiariesCount - Model.ActiveBeneficiariesCount)</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="p-3 bg-white rounded border shadow-sm">
            <span class="small-text text-muted text-uppercase fw-600">Filtered Records</span>
            <div class="fs-6 fw-bold text-teal mt-1">@Model.Beneficiaries.TotalCount Results</div>
        </div>
    </div>
</div>

<!-- ── SEARCH & FILTER PANEL ─────────────────────────────────── -->
<div class="panel mb-4">
    <div class="panel-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <!-- Search Text (Code or Name) -->
            <div class="col-md-3">
                <label class="form-label-nm mb-1">Search ID or Name</label>
                <div class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" name="search" value="@Model.Search" placeholder="e.g. BEN-PB-2026 or Gurpreet" />
                </div>
            </div>

            <!-- Centre Filter (Admin Only) -->
            @if (Model.IsAdmin)
            {
                <div class="col-md-3">
                    <label class="form-label-nm mb-1">Filter by Centre</label>
                    <select name="centreId" class="form-control-nm">
                        <option value="">All Centres</option>
                        @foreach (var c in Model.Centres)
                        {
                            <option value="@c.Value" selected="@(Model.CentreId?.ToString() == c.Value)">
                                @c.Text
                            </option>
                        }
                    </select>
                </div>
            }

            <!-- Status Filter -->
            <div class="@(Model.IsAdmin ? "col-md-2" : "col-md-3")">
                <label class="form-label-nm mb-1">Status</label>
                <select name="status" class="form-control-nm">
                    <option value="all" selected="@(Model.Status == "all")">All Statuses</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                    <option value="Discharged" selected="@(Model.Status == "Discharged")">Discharged</option>
                </select>
            </div>

            <!-- Date Range: Start -->
            <div class="col-md-2">
                <label class="form-label-nm mb-1">Registered From</label>
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control-nm" />
            </div>

            <!-- Date Range: End -->
            <div class="col-md-2">
                <label class="form-label-nm mb-1">Registered To</label>
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control-nm" />
            </div>

            <!-- Filter Buttons -->
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                @if (!string.IsNullOrEmpty(Model.Search) || Model.CentreId.HasValue || Model.Status != "all" || Model.StartDate.HasValue || Model.EndDate.HasValue)
                {
                    <a asp-action="Index" class="btn-outline-nm py-1 px-3 small-text">
                        <i class="bi bi-x-circle"></i> Clear Filters
                    </a>
                }
                <button type="submit" class="btn-primary-nm py-1 px-3 small-text">
                    <i class="bi bi-funnel-fill"></i> Apply Filters
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ── BENEFICIARIES DATA TABLE ───────────────────────────────── -->
<div class="panel">
    <div class="panel-header">
        <h2 class="panel-title">
            <i class="bi bi-person-lines-fill panel-icon"></i>
            Beneficiary Records List (@Model.Beneficiaries.TotalCount total)
        </h2>
    </div>

    <div style="overflow-x:auto;">
        <table class="data-table" aria-label="Beneficiary Records Table">
            <thead>
                <tr>
                    <th>Beneficiary Code</th>
                    <th>Full Name</th>
                    <th>Assigned Centre</th>
                    <th>Location</th>
                    <th>Registration Date</th>
                    <th>Gender</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Beneficiaries.Items.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <span class="empty-state-icon">👥</span>
                                <div class="empty-state-title">No Beneficiary Records Found</div>
                                <div class="empty-state-text">
                                    No records match your query criteria. Use the button below to register a new beneficiary.
                                </div>
                                <a asp-action="Create" class="btn-primary-nm mt-2">
                                    <i class="bi bi-person-plus-fill"></i> Register Beneficiary
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Beneficiaries.Items)
                    {
                        <tr>
                            <td>
                                <span class="id-chip">@item.BeneficiaryCode</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.BeneficiaryId" class="fw-bold text-navy">
                                    @item.FullName
                                </a>
                            </td>
                            <td>
                                <span class="small-text text-truncate d-inline-block" style="max-width:200px;" title="@item.CentreName">
                                    <i class="bi bi-hospital text-teal me-1"></i>@item.CentreName
                                </span>
                            </td>
                            <td class="small-text">
                                @item.District, @item.StateName
                            </td>
                            <td class="small-text text-muted">
                                @item.RegistrationDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="small-text text-muted">@(item.Gender ?? "—")</span>
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge-status badge-active">Active</span>
                                }
                                else if (item.Status == "Discharged")
                                {
                                    <span class="badge-status badge-completed">Discharged</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactive">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.BeneficiaryId"
                                       class="btn-outline-nm py-1 px-2 small-text" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.BeneficiaryId"
                                       class="btn-outline-nm py-1 px-2 small-text ms-1" title="Edit Record">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ── SERVER-SIDE PAGINATION ─────────────────────────────── -->
    @if (Model.Beneficiaries.TotalPages > 1)
    {
        <div class="panel-body py-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="small-text text-muted">
                Showing page <strong>@Model.Beneficiaries.PageIndex</strong> of <strong>@Model.Beneficiaries.TotalPages</strong>
                (@Model.Beneficiaries.TotalCount total records)
            </span>
            <div class="pagination-nm m-0">
                <a asp-action="Index"
                   asp-route-page="@(Model.Beneficiaries.PageIndex - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-centreId="@Model.CentreId"
                   asp-route-status="@Model.Status"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   class="page-btn @(!Model.Beneficiaries.HasPreviousPage ? "disabled" : "")">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>

                @for (int i = 1; i <= Model.Beneficiaries.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.Search"
                       asp-route-centreId="@Model.CentreId"
                       asp-route-status="@Model.Status"
                       asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                       class="page-btn @(i == Model.Beneficiaries.PageIndex ? "active" : "")">
                        @i
                    </a>
                }

                <a asp-action="Index"
                   asp-route-page="@(Model.Beneficiaries.PageIndex + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-centreId="@Model.CentreId"
                   asp-route-status="@Model.Status"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   class="page-btn @(!Model.Beneficiaries.HasNextPage ? "disabled" : "")">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    }
</div>
