@model NashaMuktiDB.ViewModels.CreateBeneficiaryViewModel
@{
    ViewData["Title"] = "Register Beneficiary";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-person-plus-fill text-teal me-2"></i>New Beneficiary Intake
        </h1>
        <p class="page-subtitle">
            Register an individual receiving de-addiction or counselling support. A unique, non-sensitive Beneficiary ID will be generated automatically.
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn-outline-nm">
            <i class="bi bi-arrow-left"></i> Back to Beneficiaries
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-card-checklist panel-icon"></i> Registration &amp; Intake Details
                </h2>
            </div>

            <div class="panel-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-nm alert-danger-nm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Create" method="post" data-loading="true">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-12">
                            <label asp-for="FullName" class="form-label-nm">
                                Beneficiary Full Name <span class="required">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control-nm" 
                                   placeholder="Full legal or identified name (e.g. Ramesh Kumar Verma)" required autofocus />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        <!-- Assigned Centre -->
                        <div class="col-md-6">
                            <label asp-for="CentreId" class="form-label-nm">
                                Assigned Centre <span class="required">*</span>
                            </label>
                            @if (Model.IsAdmin)
                            {
                                <select asp-for="CentreId" asp-items="Model.CentresList" class="form-control-nm" required>
                                    <option value="">-- Select Nasha Mukti Kendra --</option>
                                </select>
                                <span asp-validation-for="CentreId" class="field-validation-error"></span>
                            }
                            else
                            {
                                <input type="hidden" asp-for="CentreId" />
                                <input type="text" class="form-control-nm bg-light" 
                                       value="@(Model.AssignedCentreName ?? "Assigned Facility")" readonly />
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-lock-fill me-1"></i>Automatically scoped to your assigned facility.
                                </small>
                            }
                        </div>

                        <!-- Registration Date -->
                        <div class="col-md-6">
                            <label asp-for="RegistrationDate" class="form-label-nm">
                                Intake / Registration Date <span class="required">*</span>
                            </label>
                            <input asp-for="RegistrationDate" type="date" class="form-control-nm" 
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="RegistrationDate" class="field-validation-error"></span>
                        </div>

                        <!-- Date of Birth -->
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label-nm">
                                Date of Birth <span class="text-muted small-text">(Optional)</span>
                            </label>
                            <input asp-for="DateOfBirth" type="date" class="form-control-nm" 
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label-nm">
                                Gender <span class="text-muted small-text">(Optional)</span>
                            </label>
                            <select asp-for="Gender" class="form-control-nm">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                            <span asp-validation-for="Gender" class="field-validation-error"></span>
                        </div>

                        <!-- Contact Number -->
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label-nm">
                                Contact Number / Guardian Phone <span class="text-muted small-text">(Optional)</span>
                            </label>
                            <input asp-for="ContactNumber" type="tel" class="form-control-nm" 
                                   placeholder="e.g. 9876543210" />
                            <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-shield-check text-teal me-1"></i>Privacy Note: Not used as beneficiary identifier.
                            </small>
                        </div>

                        <!-- Initial Status -->
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label-nm">
                                Status <span class="required">*</span>
                            </label>
                            <select asp-for="Status" class="form-control-nm" required>
                                <option value="Active">Active (Undergoing intake / treatment)</option>
                                <option value="Inactive">Inactive / Suspended</option>
                            </select>
                            <span asp-validation-for="Status" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn-outline-nm">Cancel</a>
                        <button type="submit" class="btn-primary-nm">
                            <i class="bi bi-check-circle-fill"></i> Complete Registration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
