@model NashaMuktiDB.ViewModels.BeneficiaryDetailsViewModel
@{
    ViewData["Title"] = $"{Model.FullName} ({Model.BeneficiaryCode})";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="id-chip fs-6">@Model.BeneficiaryCode</span>
            @if (Model.Status == "Active")
            {
                <span class="badge-status badge-active">Active</span>
            }
            else if (Model.Status == "Discharged")
            {
                <span class="badge-status badge-completed">Discharged</span>
            }
            else
            {
                <span class="badge-status badge-inactive">@Model.Status</span>
            }
        </div>
        <h1 class="page-title">@Model.FullName</h1>
        <p class="page-subtitle">
            <i class="bi bi-hospital text-teal me-1"></i>Enrolled at <strong>@Model.CentreName</strong> (@Model.District, @Model.StateName)
        </p>
    </div>

    <!-- Actions -->
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn-outline-nm">
            <i class="bi bi-arrow-left"></i> Back to Beneficiaries
        </a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.BeneficiaryId" class="btn-primary-nm">
                <i class="bi bi-pencil-square"></i> Edit Profile
            </a>

            <!-- Controlled Status Toggle / Deactivation -->
            <form asp-action="ToggleStatus" asp-route-id="@Model.BeneficiaryId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" 
                        class="btn-outline-nm @(Model.Status == "Active" ? "text-danger" : "text-success")"
                        data-confirm="Are you sure you want to change status to '@(Model.Status == "Active" ? "Inactive" : "Active")'? All counselling and treatment history will be preserved.">
                    <i class="bi @(Model.Status == "Active" ? "bi-person-slash" : "bi-person-check")"></i>
                    @(Model.Status == "Active" ? "Deactivate" : "Activate")
                </button>
            </form>
        }
    </div>
</div>

<!-- ── BENEFICIARY PROFILE SUMMARY ───────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-person-vcard panel-icon"></i> Intake Profile
                </h2>
            </div>
            <div class="panel-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Full Name</dt>
                    <dd class="col-sm-8 fw-bold text-navy">@Model.FullName</dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Beneficiary ID</dt>
                    <dd class="col-sm-8"><code>@Model.BeneficiaryCode</code></dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Registration Date</dt>
                    <dd class="col-sm-8">@Model.RegistrationDate.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Date of Birth</dt>
                    <dd class="col-sm-8">
                        @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "Not Recorded")
                        @if (Model.Age.HasValue)
                        {
                            <span class="badge bg-light text-dark border ms-1">@Model.Age years</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Gender</dt>
                    <dd class="col-sm-8">@(Model.Gender ?? "Not Specified")</dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Contact Number</dt>
                    <dd class="col-sm-8">@(Model.ContactNumber ?? "Not Specified")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-hospital panel-icon"></i> Facility &amp; Status Info
                </h2>
            </div>
            <div class="panel-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Assigned Facility</dt>
                    <dd class="col-sm-8 fw-bold text-navy">
                        <a asp-controller="Centres" asp-action="Details" asp-route-id="@Model.CentreId" class="text-teal">
                            @Model.CentreName
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">District / State</dt>
                    <dd class="col-sm-8">@Model.District, @Model.StateName</dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Current Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "Active")
                        {
                            <span class="badge-status badge-active">Active (In Treatment / Care)</span>
                        }
                        else
                        {
                            <span class="badge-status badge-inactive">@Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Record Created</dt>
                    <dd class="col-sm-8 text-muted">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</dd>

                    <dt class="col-sm-4 text-muted small-text text-uppercase fw-600">Last Updated</dt>
                    <dd class="col-sm-8 text-muted">
                        @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt") + " UTC" : "Never modified")
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- ── CLINICAL & TREATMENT DOSSIER (Phase 6 Integrated) ─────── -->
<div class="row g-3 mb-4">
    <!-- Counselling Sessions -->
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <h2 class="panel-title">
                    <i class="bi bi-chat-heart panel-icon"></i> Counselling Sessions
                    <span class="badge bg-light text-dark border ms-2">@Model.CounsellingSessions.Count</span>
                </h2>
                @if (Model.CanEdit)
                {
                    <a asp-controller="Counselling" asp-action="Create" asp-route-beneficiaryId="@Model.BeneficiaryId" class="btn-primary-nm btn-sm">
                        <i class="bi bi-plus"></i> Log Session
                    </a>
                }
            </div>
            <div class="panel-body p-0">
                @if (!Model.CounsellingSessions.Any())
                {
                    <div class="text-center py-4 text-muted small-text">
                        <i class="bi bi-chat-square-text fs-2 d-block text-secondary opacity-50 mb-2"></i>
                        <div>No counselling sessions recorded yet.</div>
                        <small>Click "Log Session" to document the initial evaluation.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small-text">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Counsellor</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.CounsellingSessions)
                                {
                                    <tr>
                                        <td class="fw-600">@s.SessionDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@s.SessionType</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(s.CounsellorName) ? "—" : s.CounsellorName)</td>
                                        <td>
                                            @if (s.SessionStatus == "Completed")
                                            {
                                                <span class="badge-status badge-completed">Completed</span>
                                            }
                                            else if (s.SessionStatus == "Scheduled")
                                            {
                                                <span class="badge-status badge-active">Scheduled</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">@s.SessionStatus</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Counselling" asp-action="Details" asp-route-id="@s.SessionId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View Confidential Notes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Treatment Interventions -->
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <h2 class="panel-title">
                    <i class="bi bi-heart-pulse panel-icon"></i> Treatment Interventions
                    <span class="badge bg-light text-dark border ms-2">@Model.Interventions.Count</span>
                </h2>
                @if (Model.CanEdit)
                {
                    <a asp-controller="Interventions" asp-action="Create" asp-route-beneficiaryId="@Model.BeneficiaryId" class="btn-primary-nm btn-sm">
                        <i class="bi bi-plus"></i> Record
                    </a>
                }
            </div>
            <div class="panel-body p-0">
                @if (!Model.Interventions.Any())
                {
                    <div class="text-center py-4 text-muted small-text">
                        <i class="bi bi-heart-pulse fs-2 d-block text-secondary opacity-50 mb-2"></i>
                        <div>No treatment interventions recorded yet.</div>
                        <small>Click "Record" to log medical detox or rehabilitation protocols.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small-text">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Professional</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.Interventions)
                                {
                                    <tr>
                                        <td class="fw-600">@i.ServiceDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@i.InterventionType</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(i.ResponsibleStaffName) ? "—" : i.ResponsibleStaffName)</td>
                                        <td>
                                            @if (i.Status == "Completed")
                                            {
                                                <span class="badge-status badge-completed">Completed</span>
                                            }
                                            else if (i.Status == "In Progress")
                                            {
                                                <span class="badge-status badge-active">In Progress</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">@i.Status</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Interventions" asp-action="Details" asp-route-id="@i.InterventionId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Follow-up Timeline & Schedule -->
<div class="panel mb-4">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <h2 class="panel-title">
            <i class="bi bi-calendar2-check panel-icon"></i> Follow-up Appointments &amp; Recovery Monitoring
            <span class="badge bg-light text-dark border ms-2">@Model.FollowUps.Count</span>
        </h2>
        @if (Model.CanEdit)
        {
            <a asp-controller="FollowUps" asp-action="Create" asp-route-beneficiaryId="@Model.BeneficiaryId" class="btn-primary-nm btn-sm">
                <i class="bi bi-calendar-plus"></i> Schedule Follow-up
            </a>
        }
    </div>
    <div class="panel-body p-0">
        @if (!Model.FollowUps.Any())
        {
            <div class="text-center py-4 text-muted small-text">
                <i class="bi bi-calendar-x fs-2 d-block text-secondary opacity-50 mb-2"></i>
                <div>No follow-up appointments scheduled yet.</div>
                <small>Schedule post-treatment check-ins to monitor long-term recovery.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small-text">
                    <thead class="table-light">
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Status</th>
                            <th>Date Completed</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr class="@(f.IsOverdue ? "table-danger-subtle" : "")">
                                <td class="fw-600 @(f.IsOverdue ? "text-danger" : "")">
                                    @f.ScheduledDate.ToString("dd MMMM yyyy")
                                    @if (f.IsOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">OVERDUE</span>
                                    }
                                </td>
                                <td>
                                    @if (f.Status == "Completed")
                                    {
                                        <span class="badge-status badge-completed">Completed</span>
                                    }
                                    else if (f.Status == "Pending")
                                    {
                                        <span class="badge-status badge-active">Pending</span>
                                    }
                                    else if (f.Status == "Missed")
                                    {
                                        <span class="badge bg-warning text-dark border">Missed</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-inactive">@f.Status</span>
                                    }
                                </td>
                                <td>@(f.CompletedDate.HasValue ? f.CompletedDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td class="text-end">
                                    @if (f.Status == "Pending" && Model.CanEdit)
                                    {
                                        <a asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-success py-0 px-2 me-1" title="Record Outcome">
                                            <i class="bi bi-clipboard-check"></i> Complete
                                        </a>
                                    }
                                    <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
