@model NashaMuktiDB.ViewModels.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Establish Permanent Password";
}

<div class="login-page">
    <div class="login-card" style="max-width: 500px;">

        <!-- Security Icon -->
        <div class="text-center mb-3">
            <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(13, 148, 136, 0.12); color: var(--teal-600); display: inline-flex; align-items: center; justify-content: center; font-size: 1.75rem;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
        </div>

        <h1 class="login-heading text-center">Establish Permanent Password</h1>
        <p class="small-text text-muted text-center mb-4">
            Your account has been authorized. To ensure account security, please establish your confidential permanent password.
        </p>

        <!-- Validation Summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-nm alert-danger-nm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="ChangePassword" data-loading="true" novalidate>
            @Html.AntiForgeryToken()

            <!-- Current Password -->
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label-nm">
                    Current (Temporary) Password <span class="required">*</span>
                </label>
                <input asp-for="CurrentPassword" class="form-control-nm"
                       placeholder="Enter the initial password provided"
                       autocomplete="current-password" required autofocus />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label-nm">
                    New Permanent Password <span class="required">*</span>
                </label>
                <input asp-for="NewPassword" class="form-control-nm"
                       placeholder="Minimum 8 characters"
                       autocomplete="new-password" required />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <!-- Confirm New Password -->
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label-nm">
                    Confirm New Password <span class="required">*</span>
                </label>
                <input asp-for="ConfirmNewPassword" class="form-control-nm"
                       placeholder="Re-enter your new password"
                       autocomplete="new-password" required />
                <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
            </div>

            <!-- Password Requirements helper -->
            <div class="p-3 mb-4 rounded" style="background:var(--gray-50); border:1px solid var(--gray-200); font-size:0.8rem; color:var(--gray-600);">
                <span class="fw-600 text-navy d-block mb-1"><i class="bi bi-info-circle me-1 text-teal"></i>Password Security Policy:</span>
                <ul class="mb-0 ps-3">
                    <li>Minimum 8 characters in length</li>
                    <li>At least 1 uppercase and 1 lowercase letter</li>
                    <li>At least 1 numerical digit and 1 special symbol</li>
                </ul>
            </div>

            <button type="submit" class="btn-primary-nm w-100 justify-content-center py-3">
                <i class="bi bi-check-circle-fill"></i>
                Save Password &amp; Proceed to Dashboard
            </button>
        </form>

        <div class="login-footer mt-4">
            <i class="bi bi-shield-check text-teal me-1"></i>
            National De-Addiction Security Infrastructure (MoSJE)
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
