<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Centralised Nasha Mukti Database — Ministry of Social Justice and Empowerment" />
    <title>@ViewData["Title"] — Nasha Mukti DB</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="app-wrapper">

    <!-- ── SIDEBAR ──────────────────────────────────────── -->
    <aside class="sidebar" id="appSidebar" role="navigation" aria-label="Main navigation">

        <div class="sidebar-brand">
            <div class="sidebar-brand-icon" aria-hidden="true">🏥</div>
            <div class="sidebar-brand-text">
                <span>Nasha Mukti DB</span>
                <span>MoSJE Platform</span>
            </div>
        </div>

        <!-- OVERVIEW -->
        <div class="sidebar-section-label">Overview</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-icon bi bi-speedometer2"></span>
                    Dashboard
                </a>
            </li>
        </ul>

        <!-- RECORDS -->
        <div class="sidebar-section-label">Records</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Centres" asp-action="Index">
                    <span class="nav-icon bi bi-building"></span>
                    Centres
                </a>
            </li>
            <li>
                <a asp-controller="Beneficiaries" asp-action="Index">
                    <span class="nav-icon bi bi-people"></span>
                    Beneficiaries
                </a>
            </li>
            <li>
                <a asp-controller="Counselling" asp-action="Index">
                    <span class="nav-icon bi bi-chat-heart"></span>
                    Counselling
                </a>
            </li>
            <li>
                <a asp-controller="Interventions" asp-action="Index">
                    <span class="nav-icon bi bi-hospital"></span>
                    Interventions
                </a>
            </li>
            <li>
                <a asp-controller="FollowUps" asp-action="Index">
                    <span class="nav-icon bi bi-calendar-check"></span>
                    Follow-Ups
                </a>
            </li>
        </ul>

        <!-- ANALYSIS -->
        <div class="sidebar-section-label">Analysis</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Reports" asp-action="Index">
                    <span class="nav-icon bi bi-bar-chart-line"></span>
                    Reports
                </a>
            </li>
        </ul>

        @if (User.IsInRole("Admin"))
        {
            <!-- ADMIN -->
            <div class="sidebar-section-label">Administration</div>
            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="Admin" asp-action="Users">
                        <span class="nav-icon bi bi-person-gear"></span>
                        User Management
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="AuditLog">
                        <span class="nav-icon bi bi-shield-check"></span>
                        Audit Log
                    </a>
                </li>
            </ul>
        }

        <!-- FOOTER: User Info -->
        <div class="sidebar-footer">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">
                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="sidebar-user-info">
                        <div class="user-name">@User.Identity.Name</div>
                        <div class="user-role">
                            @(User.IsInRole("Admin") ? "System Admin" : "Centre Staff")
                        </div>
                    </div>
                    <a asp-controller="Account" asp-action="Logout"
                       data-confirm="Are you sure you want to sign out?"
                       title="Sign Out" aria-label="Sign Out">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    </aside>

    <!-- Overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

    <!-- ── MAIN CONTENT ──────────────────────────────────── -->
    <div class="main-content">

        <!-- TOPBAR -->
        <header class="topbar" role="banner">
            <button class="topbar-toggle" id="sidebarToggle"
                    aria-label="Toggle navigation" aria-expanded="false"
                    aria-controls="appSidebar">
                <i class="bi bi-list"></i>
            </button>

            <!-- Breadcrumb -->
            <nav class="topbar-breadcrumb" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-house-fill text-teal me-1"></i>Home
                        </a>
                    </li>
                    @if (ViewData["BreadcrumbParent"] != null)
                    {
                        <li class="breadcrumb-item">
                            <a href="@ViewData["BreadcrumbParentUrl"]">@ViewData["BreadcrumbParent"]</a>
                        </li>
                    }
                    @if (ViewData["Title"] != null)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    }
                </ol>
            </nav>

            <!-- Topbar Actions -->
            <div class="topbar-actions">
                <span class="d-none d-md-flex align-items-center gap-2 me-2 small-text text-muted">
                    <i class="bi bi-clock text-teal"></i>
                    <span id="topbarTime"></span>
                </span>
                <a asp-controller="Dashboard" asp-action="Index"
                   class="topbar-btn" title="Dashboard" data-bs-toggle="tooltip"
                   data-bs-placement="bottom" aria-label="Go to Dashboard">
                    <i class="bi bi-house"></i>
                </a>
                <a asp-controller="Reports" asp-action="Index"
                   class="topbar-btn" title="Reports" data-bs-toggle="tooltip"
                   data-bs-placement="bottom" aria-label="Reports">
                    <i class="bi bi-graph-up"></i>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Users"
                       class="topbar-btn" title="User Management" data-bs-toggle="tooltip"
                       data-bs-placement="bottom" aria-label="User Management">
                        <i class="bi bi-person-gear"></i>
                    </a>
                }
            </div>
        </header>

        <!-- PAGE BODY -->
        <main class="page-content" id="mainContent" role="main">

            <!-- Global Alert Banner -->
            @if (TempData["Success"] != null)
            {
                <div class="alert-nm alert-success-nm alert-auto-dismiss" role="alert">
                    <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert-nm alert-danger-nm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert-nm alert-warning-nm alert-auto-dismiss" role="alert">
                    <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                    <span>@TempData["Warning"]</span>
                </div>
            }

            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="border-top py-2 px-4 d-flex justify-content-between align-items-center"
                style="background:var(--white); font-size:.72rem; color:var(--gray-400);">
            <span>Centralised Nasha Mukti Database &copy; @DateTime.Now.Year — Academic Demonstration</span>
            <span class="d-none d-md-block">Ministry of Social Justice and Empowerment (MoSJE)</span>
        </footer>
    </div>
</div>

<!-- Bootstrap 5 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmE5zQBtjA0aeIHv0bCrmse4NF9"
        crossorigin="anonymous"></script>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<!-- Site JS -->
<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Live Clock -->
<script>
    (function () {
        const el = document.getElementById('topbarTime');
        if (!el) return;
        function tick() {
            const now = new Date();
            el.textContent = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
        }
        tick();
        setInterval(tick, 30000);
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
