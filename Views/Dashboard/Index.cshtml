@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-speedometer2 text-teal me-2"></i>Dashboard
        </h1>
        <p class="page-subtitle">
            Centralised overview of all Nasha Mukti centres and beneficiary services
        </p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge-status badge-active" title="Database connected — Synthetic academic demonstration dataset">
            <i class="bi bi-database-check me-1"></i>
            Connected &bull; Demo Data
        </span>
        <a asp-controller="Reports" asp-action="Index" class="btn-outline-nm">
            <i class="bi bi-download"></i> Export Report
        </a>
    </div>
</div>

<!-- ── KPI STAT CARDS ─────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-icon-blue">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-card-value" id="kpi-beneficiaries">—</div>
                <div class="stat-card-label">Total Beneficiaries</div>
                <div class="stat-card-change up">
                    <i class="bi bi-arrow-up-short"></i> Loading from DB...
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-icon-teal">
                <i class="bi bi-building-fill-check"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-card-value" id="kpi-centres">—</div>
                <div class="stat-card-label">Active Centres</div>
                <div class="stat-card-change up">
                    <i class="bi bi-arrow-up-short"></i> Loading from DB...
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-icon-green">
                <i class="bi bi-chat-heart-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-card-value" id="kpi-counselling">—</div>
                <div class="stat-card-label">Counselling Sessions</div>
                <div class="stat-card-change up">
                    <i class="bi bi-arrow-up-short"></i> Loading from DB...
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-icon-orange">
                <i class="bi bi-hospital-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-card-value" id="kpi-interventions">—</div>
                <div class="stat-card-label">Interventions Recorded</div>
                <div class="stat-card-change up">
                    <i class="bi bi-arrow-up-short"></i> Loading from DB...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── ROW 2: Charts ─────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <!-- Monthly Registration Trend -->
    <div class="col-lg-8">
        <div class="panel h-100">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-graph-up panel-icon"></i>
                    Monthly Beneficiary Registrations
                </h2>
                <span class="small-text text-muted">Last 12 months</span>
            </div>
            <div class="panel-body">
                <div class="chart-container">
                    <canvas id="chartMonthly" aria-label="Monthly registration trend chart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- State-wise Distribution -->
    <div class="col-lg-4">
        <div class="panel h-100">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-pie-chart panel-icon"></i>
                    Beneficiaries by State
                </h2>
            </div>
            <div class="panel-body">
                <div class="chart-container">
                    <canvas id="chartState" aria-label="State-wise beneficiary distribution chart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── ROW 3: Tables ─────────────────────────────────────────── -->
<div class="row g-3">
    <!-- Recent Registrations -->
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-clock-history panel-icon"></i>
                    Recent Beneficiary Registrations
                </h2>
                <a asp-controller="Beneficiaries" asp-action="Index"
                   class="btn-outline-nm" style="font-size:.78rem; padding:5px 12px;">
                    View All
                </a>
            </div>
            <div style="overflow-x:auto;">
                <table class="data-table" id="tblRecentBeneficiaries"
                       aria-label="Recent beneficiary registrations">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Centre</th>
                            <th>Registered</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="recentBeneficiariesBody">
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small-text">
                                <span class="spinner-nm me-2"></span> Loading...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Centre Performance -->
    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-bar-chart panel-icon"></i>
                    Centre-wise Service Count
                </h2>
                <a asp-controller="Centres" asp-action="Index"
                   class="btn-outline-nm" style="font-size:.78rem; padding:5px 12px;">
                    View All
                </a>
            </div>
            <div style="overflow-x:auto;">
                <table class="data-table" id="tblCentreStats"
                       aria-label="Centre service statistics">
                    <thead>
                        <tr>
                            <th>Centre</th>
                            <th>State</th>
                            <th>Beneficiaries</th>
                            <th>Sessions</th>
                        </tr>
                    </thead>
                    <tbody id="centreStatsBody">
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted small-text">
                                <span class="spinner-nm me-2"></span> Loading...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Follow-up Status Summary -->
<div class="row g-3 mt-0">
    <div class="col-12">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="bi bi-calendar2-week panel-icon"></i>
                    Follow-up Status Overview
                </h2>
                <a asp-controller="FollowUps" asp-action="Index"
                   class="btn-outline-nm" style="font-size:.78rem; padding:5px 12px;">
                    Manage Follow-Ups
                </a>
            </div>
            <div class="panel-body">
                <div class="row g-3" id="followupSummary">
                    <div class="col text-center py-3 text-muted small-text">
                        <span class="spinner-nm me-2"></span> Loading...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Dashboard: load stats from API ─────────────────────────────
document.addEventListener('DOMContentLoaded', async function () {

    // Chart.js global defaults
    Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = '#6c757d';

    async function fetchApi(url) {
        try {
            const r = await fetch(url, {
                headers: { 'Accept': 'application/json' },
                credentials: 'same-origin'
            });
            if (!r.ok) throw new Error(r.status);
            return await r.json();
        } catch (e) {
            console.error('API error:', url, e);
            return null;
        }
    }

    // ── KPI Cards ────────────────────────────────────────
    const stats = await fetchApi('/api/v1/dashboard/stats');
    if (stats) {
        document.getElementById('kpi-beneficiaries').textContent =
            (stats.totalBeneficiaries ?? 0).toLocaleString('en-IN');
        document.getElementById('kpi-centres').textContent =
            (stats.activeCentres ?? 0).toLocaleString('en-IN');
        document.getElementById('kpi-counselling').textContent =
            (stats.totalCounsellings ?? 0).toLocaleString('en-IN');
        document.getElementById('kpi-interventions').textContent =
            (stats.totalInterventions ?? 0).toLocaleString('en-IN');

        // Update change indicators
        document.querySelectorAll('.stat-card-change').forEach(el => {
            el.textContent = 'Activity count from DB';
            el.className = 'stat-card-change up';
        });
    }

    // ── Monthly Chart ─────────────────────────────────────
    const monthly = await fetchApi('/api/v1/dashboard/monthly-trend');
    if (monthly && document.getElementById('chartMonthly')) {
        new Chart(document.getElementById('chartMonthly'), {
            type: 'line',
            data: {
                labels: monthly.map(d => d.label),
                datasets: [{
                    label: 'Registrations',
                    data:  monthly.map(d => d.count),
                    borderColor: '#14a0a5',
                    backgroundColor: 'rgba(20,160,165,.1)',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#14a0a5',
                    pointRadius: 4,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.05)' }, ticks: { stepSize: 1 } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // ── State Pie Chart ───────────────────────────────────
    const stateData = await fetchApi('/api/v1/dashboard/state-stats');
    if (stateData && document.getElementById('chartState')) {
        const palette = [
            '#0d7377','#14a0a5','#1ab8be','#4ecdc4','#163263',
            '#1e4080','#f4c430','#198754','#fd7e14','#6f42c1'
        ];
        new Chart(document.getElementById('chartState'), {
            type: 'doughnut',
            data: {
                labels: stateData.map(d => d.state),
                datasets: [{
                    data: stateData.map(d => d.count),
                    backgroundColor: palette,
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 12, font: { size: 11 }, usePointStyle: true }
                    }
                },
                cutout: '60%'
            }
        });
    }

    // ── Recent Beneficiaries Table ────────────────────────
    const recent = await fetchApi('/api/v1/dashboard/recent-beneficiaries');
    const tbody = document.getElementById('recentBeneficiariesBody');
    if (recent && tbody) {
        if (recent.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted small-text">No records yet</td></tr>`;
        } else {
            tbody.innerHTML = recent.map(b => `
                <tr>
                    <td><span class="id-chip">${b.beneficiaryId}</span></td>
                    <td>
                        <a href="/Beneficiaries/Details/${b.id}" class="fw-600 text-navy">
                            ${escHtml(b.name)}
                        </a>
                    </td>
                    <td>${escHtml(b.centreName)}</td>
                    <td class="small-text text-muted">${b.registrationDate}</td>
                    <td><span class="badge-status badge-active">Active</span></td>
                </tr>
            `).join('');
        }
    }

    // ── Centre Stats Table ────────────────────────────────
    const centreStats = await fetchApi('/api/v1/dashboard/centre-stats');
    const ctbody = document.getElementById('centreStatsBody');
    if (centreStats && ctbody) {
        if (centreStats.length === 0) {
            ctbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted small-text">No data yet</td></tr>`;
        } else {
            ctbody.innerHTML = centreStats.map(c => `
                <tr>
                    <td class="fw-600">${escHtml(c.name)}</td>
                    <td class="small-text">${escHtml(c.state)}</td>
                    <td>${c.beneficiaryCount}</td>
                    <td>${c.sessionCount}</td>
                </tr>
            `).join('');
        }
    }

    // ── Follow-up Summary ─────────────────────────────────
    const fuStats = await fetchApi('/api/v1/dashboard/followup-stats');
    const fuEl = document.getElementById('followupSummary');
    if (fuStats && fuEl) {
        const items = [
            { label: 'Pending',   value: fuStats.pending,   cls: 'badge-pending',   icon: 'bi-clock' },
            { label: 'Completed', value: fuStats.completed, cls: 'badge-completed', icon: 'bi-check-circle' },
            { label: 'Missed',    value: fuStats.missed,    cls: 'badge-missed',    icon: 'bi-x-circle' },
            { label: 'Cancelled', value: fuStats.cancelled, cls: 'badge-cancelled', icon: 'bi-dash-circle' }
        ];
        fuEl.innerHTML = items.map(it => `
            <div class="col-sm-6 col-md-3">
                <div class="text-center p-3 rounded" style="background:var(--gray-50); border:1px solid var(--gray-200);">
                    <i class="bi ${it.icon} fs-4 mb-2 d-block" style="color:var(--teal-500);"></i>
                    <div style="font-size:1.6rem; font-weight:800; color:var(--navy-900);">${it.value ?? 0}</div>
                    <span class="badge-status ${it.cls} mt-1">${it.label}</span>
                </div>
            </div>
        `).join('');
    }

    function escHtml(str) {
        return String(str ?? '')
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
});
</script>
}

