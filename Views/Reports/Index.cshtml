@model NashaMuktiDB.ViewModels.ReportsIndexViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-bar-chart-line-fill text-teal me-2"></i>Reports &amp; Analytics
        </h1>
        <p class="page-subtitle">
            SQL Server-powered clinical analytics, facility performance summaries, and national recovery indicators.
        </p>
    </div>

    <!-- Export Action Dropdown -->
    <div class="d-flex gap-2 flex-wrap">
        <div class="dropdown">
            <button class="btn-primary-nm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-file-earmark-arrow-down"></i> Export Reports (CSV)
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <a class="dropdown-item py-2" asp-action="ExportSummary" 
                       asp-route-stateId="@Model.Filter.StateId"
                       asp-route-district="@Model.Filter.District"
                       asp-route-centreId="@Model.Filter.CentreId"
                       asp-route-startDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))">
                        <i class="bi bi-file-earmark-spreadsheet text-teal me-2"></i> Centre Performance Summary (CSV)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-action="ExportBeneficiaries" 
                       asp-route-stateId="@Model.Filter.StateId"
                       asp-route-district="@Model.Filter.District"
                       asp-route-centreId="@Model.Filter.CentreId"
                       asp-route-startDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))">
                        <i class="bi bi-people text-primary me-2"></i> Beneficiary Dossier Report (CSV)
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Filter Panel -->
<div class="panel mb-4">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <h2 class="panel-title">
            <i class="bi bi-funnel panel-icon"></i> Reporting Scope &amp; Filters
        </h2>
        <span class="badge bg-light text-muted border">
            Active Period: <strong>@Model.Metrics.PeriodDescription</strong>
        </span>
    </div>
    <div class="panel-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end" id="reportFilterForm">
            <input type="hidden" name="activeTab" id="activeTabInput" value="@Model.Filter.ActiveTab" />

            @if (Model.Filter.IsAdmin)
            {
                <div class="col-md-3">
                    <label class="form-label small-text fw-600">State / UT</label>
                    <select name="stateId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All States</option>
                        @foreach (var s in Model.Filter.StatesList)
                        {
                            <option value="@s.Value" selected="@s.Selected">@s.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small-text fw-600">De-Addiction Centre</label>
                    <select name="centreId" class="form-select form-select-sm">
                        <option value="">All Centres</option>
                        @foreach (var c in Model.Filter.CentresList)
                        {
                            <option value="@c.Value" selected="@c.Selected">@c.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small-text fw-600">District</label>
                    <select name="district" class="form-select form-select-sm">
                        <option value="">All Districts</option>
                        @foreach (var d in Model.Filter.DistrictsList)
                        {
                            <option value="@d.Value" selected="@d.Selected">@d.Text</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="col-md-8">
                    <label class="form-label small-text fw-600">Authorized Facility Scope</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-muted"></i></span>
                        <input type="text" class="form-control" value="@Model.Filter.UserCentreName" readonly />
                    </div>
                    <input type="hidden" name="centreId" value="@Model.Filter.UserCentreId" />
                </div>
            }

            <div class="col-md-2">
                <label class="form-label small-text fw-600">Start Date</label>
                <input type="date" name="startDate" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <div class="col-md-2">
                <label class="form-label small-text fw-600">End Date</label>
                <input type="date" name="endDate" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                <button type="submit" class="btn-primary-nm btn-sm">
                    <i class="bi bi-check2-circle"></i> Apply Filters
                </button>
                <a asp-action="Index" class="btn-outline-nm btn-sm">
                    <i class="bi bi-x-circle"></i> Reset All
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ── EXECUTIVE METRIC CARDS ─────────────────────────────────── -->
<div class="row g-3 mb-4">
    <!-- Beneficiaries Total -->
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-label">Total Beneficiaries</div>
                    <div class="kpi-value text-navy">@Model.Metrics.TotalRegisteredBeneficiaries</div>
                    <div class="small-text text-muted">Active: <strong>@Model.Metrics.ActiveBeneficiaries</strong></div>
                </div>
                <div class="kpi-icon-wrap bg-light-primary text-teal">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
            <div class="border-top mt-2 pt-1 text-muted" style="font-size:0.75rem;">
                Rule: Unique beneficiaries registered in scope
            </div>
        </div>
    </div>

    <!-- Centres Total -->
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-label">Registered Facilities</div>
                    <div class="kpi-value text-navy">@Model.Metrics.TotalRegisteredCentres</div>
                    <div class="small-text text-success">Active: <strong>@Model.Metrics.ActiveCentres</strong></div>
                </div>
                <div class="kpi-icon-wrap bg-light-primary text-primary">
                    <i class="bi bi-hospital-fill fs-3"></i>
                </div>
            </div>
            <div class="border-top mt-2 pt-1 text-muted" style="font-size:0.75rem;">
                Rule: De-addiction centres in selected scope
            </div>
        </div>
    </div>

    <!-- Counselling Sessions -->
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-label">Counselling Sessions</div>
                    <div class="kpi-value text-success">@Model.Metrics.TotalCounsellingSessions</div>
                    <div class="small-text text-muted">Unique therapeutic contacts</div>
                </div>
                <div class="kpi-icon-wrap bg-light-success text-success">
                    <i class="bi bi-chat-heart-fill fs-3"></i>
                </div>
            </div>
            <div class="border-top mt-2 pt-1 text-muted" style="font-size:0.75rem;">
                Rule: Individual, group &amp; family sessions
            </div>
        </div>
    </div>

    <!-- Interventions Recorded -->
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-label">Interventions Recorded</div>
                    <div class="kpi-value text-primary">@Model.Metrics.TotalRecordedInterventions</div>
                    <div class="small-text text-muted">Medical detox &amp; rehab stages</div>
                </div>
                <div class="kpi-icon-wrap bg-light-primary text-teal">
                    <i class="bi bi-heart-pulse-fill fs-3"></i>
                </div>
            </div>
            <div class="border-top mt-2 pt-1 text-muted" style="font-size:0.75rem;">
                Rule: Clinical protocols commenced in period
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Pending Follow-ups -->
    <div class="col-md-6 col-lg-4">
        <div class="p-3 bg-white rounded border shadow-sm h-100 d-flex justify-content-between align-items-center">
            <div>
                <span class="small-text text-muted text-uppercase fw-600">Pending Follow-ups</span>
                <div class="fs-4 fw-bold text-navy">@Model.Metrics.PendingFollowUps</div>
                <div class="small-text text-muted">Scheduled recovery check-ins</div>
            </div>
            <div class="p-2 rounded bg-light-primary text-teal">
                <i class="bi bi-clock-history fs-3"></i>
            </div>
        </div>
    </div>

    <!-- Overdue Follow-ups -->
    <div class="col-md-6 col-lg-4">
        <div class="p-3 bg-white rounded border shadow-sm h-100 d-flex justify-content-between align-items-center">
            <div>
                <span class="small-text text-muted text-uppercase fw-600 text-danger">Overdue Follow-ups</span>
                <div class="fs-4 fw-bold text-danger">@Model.Metrics.OverdueFollowUps</div>
                <div class="small-text text-danger">Pending appointments past due date</div>
            </div>
            <div class="p-2 rounded bg-light-danger text-danger">
                <i class="bi bi-exclamation-triangle-fill fs-3"></i>
            </div>
        </div>
    </div>

    <!-- Period Registrations -->
    <div class="col-md-12 col-lg-4">
        <div class="p-3 bg-white rounded border shadow-sm h-100 d-flex justify-content-between align-items-center">
            <div>
                <span class="small-text text-muted text-uppercase fw-600">Period Registrations</span>
                <div class="fs-4 fw-bold text-teal">@Model.Metrics.NewRegistrationsInPeriod</div>
                <div class="small-text text-muted">@Model.Metrics.PeriodDescription</div>
            </div>
            <div class="p-2 rounded bg-light-primary text-primary">
                <i class="bi bi-person-plus-fill fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- ── TABBED REPORT SECTIONS ─────────────────────────────────── -->
<div class="panel">
    <div class="panel-header border-bottom-0 pb-0">
        <ul class="nav nav-tabs border-bottom-0" id="reportTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.Filter.ActiveTab == "overview" ? "active" : "") fw-600" 
                        id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab"
                        onclick="document.getElementById('activeTabInput').value='overview'">
                    <i class="bi bi-graph-up me-1"></i> Visual Trends &amp; Overview
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.Filter.ActiveTab == "centres" ? "active" : "") fw-600" 
                        id="centres-tab" data-bs-toggle="tab" data-bs-target="#centres" type="button" role="tab"
                        onclick="document.getElementById('activeTabInput').value='centres'">
                    <i class="bi bi-hospital me-1"></i> Centre Performance
                    <span class="badge bg-light text-dark border ms-1">@Model.CentreReports.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.Filter.ActiveTab == "states" ? "active" : "") fw-600" 
                        id="states-tab" data-bs-toggle="tab" data-bs-target="#states" type="button" role="tab"
                        onclick="document.getElementById('activeTabInput').value='states'">
                    <i class="bi bi-map me-1"></i> State Summaries
                    <span class="badge bg-light text-dark border ms-1">@Model.StateReports.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.Filter.ActiveTab == "beneficiaries" ? "active" : "") fw-600" 
                        id="beneficiaries-tab" data-bs-toggle="tab" data-bs-target="#beneficiaries" type="button" role="tab"
                        onclick="document.getElementById('activeTabInput').value='beneficiaries'">
                    <i class="bi bi-people me-1"></i> Beneficiary Dossier
                    <span class="badge bg-light text-dark border ms-1">@Model.BeneficiaryReports.TotalCount</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="panel-body pt-3">
        <div class="tab-content" id="reportTabsContent">

            <!-- ══════════════════════════════════════════════════════════════════
                 TAB 1: VISUAL TRENDS & CHARTS
                 ══════════════════════════════════════════════════════════════════ -->
            <div class="tab-pane fade @(Model.Filter.ActiveTab == "overview" ? "show active" : "")" id="overview" role="tabpanel">
                <div class="row g-4 mb-4">
                    <!-- 12-Month Multi-Series Trend Line Chart -->
                    <div class="col-lg-8">
                        <div class="p-3 bg-light rounded border h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h3 class="fs-6 fw-bold text-navy mb-0">
                                    <i class="bi bi-graph-up text-teal me-1"></i> Monthly Activity Trends (Last 12 Months)
                                </h3>
                                <span class="small-text text-muted">Registrations vs Counselling vs Interventions</span>
                            </div>
                            <div style="height: 280px; position: relative;">
                                <canvas id="monthlyActivityChart"></canvas>
                            </div>

                            <!-- Accessible Table for Line Chart -->
                            <details class="mt-3">
                                <summary class="small-text text-muted cursor-pointer">View accessible data table for monthly trends</summary>
                                <div class="table-responsive mt-2">
                                    <table class="table table-sm table-bordered small-text mb-0 bg-white">
                                        <thead>
                                            <tr>
                                                <th>Month</th>
                                                <th>New Registrations</th>
                                                <th>Counselling Sessions</th>
                                                <th>Interventions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in Model.MonthlyTrends)
                                            {
                                                <tr>
                                                    <td>@m.MonthLabel</td>
                                                    <td>@m.RegistrationCount</td>
                                                    <td>@m.CounsellingCount</td>
                                                    <td>@m.InterventionCount</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        </div>
                    </div>

                    <!-- Doughnut: Intervention Categories Breakdown -->
                    <div class="col-lg-4">
                        <div class="p-3 bg-light rounded border h-100">
                            <h3 class="fs-6 fw-bold text-navy mb-2">
                                <i class="bi bi-pie-chart text-teal me-1"></i> Intervention Protocols Breakdown
                            </h3>
                            <div style="height: 220px; position: relative;">
                                <canvas id="interventionCategoryChart"></canvas>
                            </div>

                            <ul class="list-group list-group-flush small-text mt-2 bg-transparent">
                                @foreach (var c in Model.InterventionCategories)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-1">
                                        <span>@c.Category</span>
                                        <span class="badge bg-light text-dark border">@c.Count (@c.Percentage%)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Follow-up Outcomes Bar Chart -->
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h3 class="fs-6 fw-bold text-navy mb-2">
                                <i class="bi bi-bar-chart text-teal me-1"></i> Follow-up Outcomes &amp; Retention
                            </h3>
                            <div style="height: 220px; position: relative;">
                                <canvas id="followupStatusBarChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Counselling Session Modalities Breakdown -->
                    <div class="col-lg-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h3 class="fs-6 fw-bold text-navy mb-2">
                                <i class="bi bi-chat-quote text-teal me-1"></i> Counselling Modality Distribution
                            </h3>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle small-text mb-0 bg-white">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Session Modality</th>
                                            <th class="text-end">Sessions Conducted</th>
                                            <th class="text-end">Share (%)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cs in Model.CounsellingTypes)
                                        {
                                            <tr>
                                                <td class="fw-600">@cs.Category</td>
                                                <td class="text-end">@cs.Count</td>
                                                <td class="text-end">
                                                    <span class="badge bg-light text-dark border">@cs.Percentage%</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════════════════
                 TAB 2: CENTRE-WISE PERFORMANCE REPORT
                 ══════════════════════════════════════════════════════════════════ -->
            <div class="tab-pane fade @(Model.Filter.ActiveTab == "centres" ? "show active" : "")" id="centres" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small-text text-muted">
                        Corresponds to SQL Server View: <code>vw_CentreServiceSummary</code>
                    </span>
                    <a asp-action="ExportSummary" 
                       asp-route-stateId="@Model.Filter.StateId"
                       asp-route-centreId="@Model.Filter.CentreId"
                       asp-route-startDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))"
                       class="btn-outline-nm btn-sm">
                        <i class="bi bi-download"></i> Export Table (CSV)
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Centre Name</th>
                                <th>State / District</th>
                                <th>Status</th>
                                <th class="text-end">Total Ben.</th>
                                <th class="text-end">Active Ben.</th>
                                <th class="text-end">Counselling</th>
                                <th class="text-end">Interventions</th>
                                <th class="text-end">Follow-ups</th>
                                <th class="text-end">Overdue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.CentreReports.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">
                                        No centres found matching the selected filters.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var c in Model.CentreReports)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Centres" asp-action="Details" asp-route-id="@c.CentreId" class="fw-bold text-navy text-decoration-none">
                                                @c.CentreName
                                            </a>
                                        </td>
                                        <td>
                                            <div>@c.District</div>
                                            <span class="small-text text-muted">@c.StateName</span>
                                        </td>
                                        <td>
                                            @if (c.IsActive)
                                            {
                                                <span class="badge-status badge-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end fw-600">@c.TotalBeneficiaries</td>
                                        <td class="text-end text-success">@c.ActiveBeneficiaries</td>
                                        <td class="text-end">@c.TotalCounsellingSessions</td>
                                        <td class="text-end">@c.TotalInterventions</td>
                                        <td class="text-end">@c.TotalFollowUps</td>
                                        <td class="text-end @(c.OverdueFollowUps > 0 ? "text-danger fw-bold" : "text-muted")">
                                            @c.OverdueFollowUps
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════════════════
                 TAB 3: STATE-WISE SUMMARY REPORT
                 ══════════════════════════════════════════════════════════════════ -->
            <div class="tab-pane fade @(Model.Filter.ActiveTab == "states" ? "show active" : "")" id="states" role="tabpanel">
                <div class="mb-3">
                    <span class="small-text text-muted">
                        Corresponds to SQL Server View: <code>vw_StateBeneficiarySummary</code>
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>State / Union Territory</th>
                                <th class="text-end">Total Facilities</th>
                                <th class="text-end">Active Facilities</th>
                                <th class="text-end">Beneficiaries Enrolled</th>
                                <th class="text-end">Active in Care</th>
                                <th class="text-end">Counselling Sessions</th>
                                <th class="text-end">Interventions</th>
                                <th class="text-end" style="min-width: 140px;">National Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.StateReports)
                            {
                                <tr>
                                    <td class="fw-bold text-navy">
                                        <i class="bi bi-geo-alt text-teal me-1"></i>@s.StateName
                                    </td>
                                    <td class="text-end">@s.TotalCentres</td>
                                    <td class="text-end text-success">@s.ActiveCentres</td>
                                    <td class="text-end fw-600">@s.TotalBeneficiaries</td>
                                    <td class="text-end text-success">@s.ActiveBeneficiaries</td>
                                    <td class="text-end">@s.TotalCounsellingSessions</td>
                                    <td class="text-end">@s.TotalInterventions</td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar bg-teal" role="progressbar" style="width: @s.BeneficiaryPercentage%"></div>
                                            </div>
                                            <span class="small-text fw-600">@s.BeneficiaryPercentage%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════════════════
                 TAB 4: BENEFICIARY CLINICAL DOSSIER REPORT
                 ══════════════════════════════════════════════════════════════════ -->
            <div class="tab-pane fade @(Model.Filter.ActiveTab == "beneficiaries" ? "show active" : "")" id="beneficiaries" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small-text text-muted">
                        Page @Model.BeneficiaryReports.PageIndex of @Model.BeneficiaryReports.TotalPages (@Model.BeneficiaryReports.TotalCount total records)
                        <span class="badge bg-light text-danger border ms-1"><i class="bi bi-shield-lock-fill me-1"></i>Confidential clinical notes protected</span>
                    </span>
                    <a asp-action="ExportBeneficiaries" 
                       asp-route-stateId="@Model.Filter.StateId"
                       asp-route-centreId="@Model.Filter.CentreId"
                       asp-route-startDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))"
                       class="btn-outline-nm btn-sm">
                        <i class="bi bi-download"></i> Export Dossier (CSV)
                    </a>
                </div>

                @if (!Model.BeneficiaryReports.Any())
                {
                    <div class="empty-state py-5">
                        <i class="bi bi-person-x empty-state-icon"></i>
                        <div class="empty-state-title">No Beneficiary Records in Scope</div>
                        <p class="empty-state-text">No beneficiary records match the specified filters.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Beneficiary ID</th>
                                    <th>Full Name</th>
                                    <th>Facility</th>
                                    <th>Registration Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Counselling</th>
                                    <th class="text-end">Interventions</th>
                                    <th class="text-end">Pending Follow-ups</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.BeneficiaryReports)
                                {
                                    <tr>
                                        <td><span class="id-chip small-text">@b.BeneficiaryCode</span></td>
                                        <td class="fw-bold text-navy">@b.FullName</td>
                                        <td>
                                            <div>@b.CentreName</div>
                                            <span class="small-text text-muted">@b.District, @b.StateName</span>
                                        </td>
                                        <td>@b.RegistrationDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (b.Status == "Active")
                                            {
                                                <span class="badge-status badge-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">@b.Status</span>
                                            }
                                        </td>
                                        <td class="text-end fw-600">@b.CounsellingCount</td>
                                        <td class="text-end fw-600">@b.InterventionCount</td>
                                        <td class="text-end">
                                            @if (b.PendingFollowUps > 0)
                                            {
                                                <span class="badge bg-warning text-dark border">@b.PendingFollowUps Pending</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small-text">None</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Beneficiaries" asp-action="Details" asp-route-id="@b.BeneficiaryId" class="btn btn-sm btn-outline-secondary" title="View Full Clinical Dossier">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.BeneficiaryReports.TotalPages > 1)
                    {
                        <div class="panel-body border-top py-3 d-flex justify-content-between align-items-center">
                            <span class="small-text text-muted">Showing page @Model.BeneficiaryReports.PageIndex of @Model.BeneficiaryReports.TotalPages</span>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(!Model.BeneficiaryReports.HasPreviousPage ? "disabled" : "")">
                                        <a class="page-link" asp-action="Index" 
                                           asp-route-page="@(Model.BeneficiaryReports.PageIndex - 1)"
                                           asp-route-activeTab="beneficiaries"
                                           asp-route-stateId="@Model.Filter.StateId"
                                           asp-route-centreId="@Model.Filter.CentreId"
                                           asp-route-district="@Model.Filter.District"
                                           asp-route-startDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-endDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))">Previous</a>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">@Model.BeneficiaryReports.PageIndex</span>
                                    </li>
                                    <li class="page-item @(!Model.BeneficiaryReports.HasNextPage ? "disabled" : "")">
                                        <a class="page-link" asp-action="Index" 
                                           asp-route-page="@(Model.BeneficiaryReports.PageIndex + 1)"
                                           asp-route-activeTab="beneficiaries"
                                           asp-route-stateId="@Model.Filter.StateId"
                                           asp-route-centreId="@Model.Filter.CentreId"
                                           asp-route-district="@Model.Filter.District"
                                           asp-route-startDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-endDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Colors matching our design system
            const colorTeal = '#0d9488';
            const colorNavy = '#0f172a';
            const colorPrimary = '#2563eb';
            const colorSuccess = '#16a34a';
            const colorWarning = '#eab308';
            const colorDanger = '#dc2626';

            // 1. Monthly Trends Chart
            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.MonthLabel)));
            const regData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.RegistrationCount)));
            const sesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.CounsellingCount)));
            const intData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.InterventionCount)));

            const ctxMonthly = document.getElementById('monthlyActivityChart');
            if (ctxMonthly) {
                new Chart(ctxMonthly, {
                    type: 'line',
                    data: {
                        labels: monthlyLabels,
                        datasets: [
                            {
                                label: 'Registrations',
                                data: regData,
                                borderColor: colorTeal,
                                backgroundColor: 'rgba(13, 148, 136, 0.1)',
                                tension: 0.3,
                                fill: true,
                                borderWidth: 2
                            },
                            {
                                label: 'Counselling Sessions',
                                data: sesData,
                                borderColor: colorSuccess,
                                backgroundColor: 'transparent',
                                tension: 0.3,
                                borderWidth: 2
                            },
                            {
                                label: 'Interventions',
                                data: intData,
                                borderColor: colorPrimary,
                                backgroundColor: 'transparent',
                                tension: 0.3,
                                borderWidth: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }

            // 2. Intervention Category Doughnut
            const intCatLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InterventionCategories.Select(c => c.Category)));
            const intCatData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InterventionCategories.Select(c => c.Count)));

            const ctxCat = document.getElementById('interventionCategoryChart');
            if (ctxCat && intCatData.length > 0) {
                new Chart(ctxCat, {
                    type: 'doughnut',
                    data: {
                        labels: intCatLabels,
                        datasets: [{
                            data: intCatData,
                            backgroundColor: [
                                '#0d9488', '#2563eb', '#16a34a', '#f59e0b', '#8b5cf6', '#ec4899'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // 3. Follow-up Outcomes Bar Chart
            const ctxFollowup = document.getElementById('followupStatusBarChart');
            if (ctxFollowup) {
                new Chart(ctxFollowup, {
                    type: 'bar',
                    data: {
                        labels: ['Pending', 'Completed', 'Overdue', 'Missed', 'Cancelled'],
                        datasets: [{
                            label: 'Follow-ups',
                            data: [
                                @Model.FollowUpStatusDistribution.PendingCount,
                                @Model.FollowUpStatusDistribution.CompletedCount,
                                @Model.FollowUpStatusDistribution.OverdueCount,
                                @Model.FollowUpStatusDistribution.MissedCount,
                                @Model.FollowUpStatusDistribution.CancelledCount
                            ],
                            backgroundColor: [
                                colorPrimary,
                                colorSuccess,
                                colorDanger,
                                colorWarning,
                                '#94a3b8'
                            ],
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }
        });
    </script>
}
